module: ietf-yang-package-types

  grouping yang-pkg-instance:
    +-- name                   pkg-name
    +-- version                pkg-version
    +-- version-description?   string
    +-- timestamp?             yang:date-and-time
    +-- organization?          string
    +-- contact?               string
    +-- description?           string
    +-- reference?             string
    +-- complete?              boolean
    +-- includes
    |  +-- package* [name version]
    |  |  +-- name                pkg-name
    |  |  +-- version             pkg-version
    |  |  +-- location*           inet:uri
    |  |  +-- location-sha-256*   sha-256-hash
    |  +-- module* [name]
    |  |  +-- name                module-name
    |  |  +-- version             version-or-rev-date
    |  |  +-- location*           inet:uri
    |  |  +-- location-sha-256*   sha-256-hash
    |  |  +-- submodule* [name]
    |  |     +-- name                module-name
    |  |     +-- version             version-or-rev-date
    |  |     +-- location*           inet:uri
    |  |     +-- location-sha-256*   sha-256-hash
    |  +-- import-only-module* [name version]
    |  |  +-- name                module-name
    |  |  +-- version             version-or-rev-date
    |  |  +-- location*           inet:uri
    |  |  +-- location-sha-256*   sha-256-hash
    |  |  +-- submodule* [name]
    |  |     +-- name                module-name
    |  |     +-- version             version-or-rev-date
    |  |     +-- location*           inet:uri
    |  |     +-- location-sha-256*   sha-256-hash
    |  +-- feature*              scoped-feature
    +-- excludes
    |  +-- module*               module-name
    |  +-- import-only-module* [name]
    |  |  +-- name       module-name
    |  |  +-- version*   version-or-rev-date
    |  +-- feature*              scoped-feature
    +-- depends-on
    |  +-- package* [name version]
    |     +-- name                pkg-name
    |     +-- version             pkg-version
    |     +-- location*           inet:uri
    |     +-- location-sha-256*   sha-256-hash
    +-- mount* [mount-path]
       +-- mount-path                pkg-ypath
       +-- inherit-mounted-schema?   boolean
       +-- read-only?                boolean
       +-- mount-mode?               enumeration
       +-- package* [name version]
       |  +-- name                pkg-name
       |  +-- version             pkg-version
       |  +-- location*           inet:uri
       |  +-- location-sha-256*   sha-256-hash
       +-- feature*                  scoped-feature
       +-- parent-reference*         pkg-ypath
