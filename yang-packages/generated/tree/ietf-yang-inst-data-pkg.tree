module: ietf-yang-inst-data-pkg

  augment-structure /yid:instance-data-set/yid:content-schema/yid:content-schema-spec:
    +--:(pkg-schema)
       +-- pkg-schema
          +-- schema              pkg-types:pkg-reference
          +-- location*           inet:uri
          +-- location-sha-256*   sha-256-hash
