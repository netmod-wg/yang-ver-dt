module: ietf-yang-device-schema
  +--ro device-schema
     +--ro device          string
     +--ro release         string
     +--ro yang-library?   inet:uri
     +--ro schema* [name]
     |  +--ro name       string
     |  +--ro package* [name version]
     |  |  +--ro name                pkg-name
     |  |  +--ro version             pkg-version
     |  |  +--ro location*           inet:uri
     |  |  +--ro location-sha-256*   sha-256-hash
     |  +--ro feature*   pkg-types:scoped-feature
     +--ro datastore* [name]
        +--ro name      ds:datastore-ref
        +--ro schema    -> ../../schema/name
