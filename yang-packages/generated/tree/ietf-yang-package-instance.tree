module: ietf-yang-package-instance

  structure package:
    +-- name                   pkg-name
    +-- version                pkg-version
    +-- version-description?   string
    +-- timestamp?             yang:date-and-time
    +-- organization?          string
    +-- contact?               string
    +-- description?           string
    +-- reference?             string
    +-- complete?              boolean
    +-- includes
    |  +-- package* [name version]
    |  |  +-- name        pkg-name
    |  |  +-- version     pkg-version
    |  |  +-- location*   inet:uri
    |  +-- module* [name]
    |  |  +-- name         module-name
    |  |  +-- version      version-or-rev-date
    |  |  +-- location*    inet:uri
    |  |  +-- submodule* [name]
    |  |     +-- name        module-name
    |  |     +-- version     version-or-rev-date
    |  |     +-- location*   inet:uri
    |  +-- import-only-module* [name version]
    |  |  +-- name         module-name
    |  |  +-- version      version-or-rev-date
    |  |  +-- location*    inet:uri
    |  |  +-- submodule* [name]
    |  |     +-- name        module-name
    |  |     +-- version     version-or-rev-date
    |  |     +-- location*   inet:uri
    |  +-- feature*              scoped-feature
    +-- excludes
    |  +-- module*               module-name
    |  +-- import-only-module* [name]
    |  |  +-- name       module-name
    |  |  +-- version*   version-or-rev-date
    |  +-- feature*              scoped-feature
    +-- mount* [mount-path]
       +-- mount-path            mount-ypath
       +-- inherit-packages?     boolean
       +-- package* [name version]
       |  +-- name        pkg-name
       |  +-- version     pkg-version
       |  +-- location*   inet:uri
       +-- additional-feature*   scoped-feature
       +-- parent-reference*     mount-ypath
