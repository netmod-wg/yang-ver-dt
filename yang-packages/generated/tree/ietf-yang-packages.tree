module: ietf-yang-packages
  +--ro packages
     +--ro package* [name version]
        +--ro name                   pkg-name
        +--ro version                pkg-version
        +--ro version-description?   string
        +--ro timestamp?             yang:date-and-time
        +--ro organization?          string
        +--ro contact?               string
        +--ro description?           string
        +--ro reference?             string
        +--ro complete?              boolean
        +--ro includes
        |  +--ro package* [name version]
        |  |  +--ro name        pkg-name
        |  |  +--ro version     pkg-version
        |  |  +--ro location*   inet:uri
        |  +--ro module* [name]
        |  |  +--ro name         module-name
        |  |  +--ro version      version-or-rev-date
        |  |  +--ro location*    inet:uri
        |  |  +--ro submodule* [name]
        |  |     +--ro name        module-name
        |  |     +--ro version     version-or-rev-date
        |  |     +--ro location*   inet:uri
        |  +--ro import-only-module* [name version]
        |  |  +--ro name         module-name
        |  |  +--ro version      version-or-rev-date
        |  |  +--ro location*    inet:uri
        |  |  +--ro submodule* [name]
        |  |     +--ro name        module-name
        |  |     +--ro version     version-or-rev-date
        |  |     +--ro location*   inet:uri
        |  +--ro feature*              scoped-feature
        +--ro excludes
        |  +--ro module*               module-name
        |  +--ro import-only-module* [name]
        |  |  +--ro name       module-name
        |  |  +--ro version*   version-or-rev-date
        |  +--ro feature*              scoped-feature
        +--ro mount* [mount-path]
           +--ro mount-path            mount-ypath
           +--ro inherit-packages?     boolean
           +--ro package* [name version]
           |  +--ro name        pkg-name
           |  +--ro version     pkg-version
           |  +--ro location*   inet:uri
           +--ro additional-feature*   scoped-feature
           +--ro parent-reference*     mount-ypath
