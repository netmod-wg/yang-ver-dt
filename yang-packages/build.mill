object ExampleNetworkDevicePkg extends ExamplePkgDefn {
  def name = "example-network-device"
  def version = "1.1.2"
  override def timestamp = "2018-12-13T17:00:00Z"
  def organization = "IETF NETMOD Working Group"
  def contact =
    "WG Web:   <http://tools.ietf.org/wg/netmod/>, " +
      "WG List:  <mailto:netmod@ietf.org>"
  def description =
    descriptionText("""|Example IETF network device YANG package.
       |
       |This package defines a small sample set of YANG modules that could
       |represent the basic set of modules that a standard network device might
       |be expected to support.""")
  def reference = "XXX, draft-ietf-netmod-yang-packages"
  def includedPackages = Seq(ExampleBaseTypesPkg_1_0_0)

  private def ietfModule(name: String, revision: String) =
    yang.packages.tools.lib.Module(
      name,
      ModuleVersion(revision),
      Seq(s"https://www.iana.org/assignments/yang-parameters/$name@$revision.yang")
    )

  override def modules =
    Seq(
      ietfModule("iana-crypt-hash", "2014-08-06"),
      ietfModule("ietf-system", "2014-08-06"),
      ietfModule("iana-if-type", "2026-03-17"),
      ietfModule("ietf-interfaces", "2018-02-20"),
      ietfModule("ietf-netconf-acm", "2018-02-14"),
      ietfModule("ietf-key-chain", "2017-06-15"),
      ietfModule("ietf-ip", "2018-02-22"),
    )
  override def mandatoryFeatures =
    Seq(
      "ietf-system:authentication",
      "ietf-system:local-users",
      "ietf-system:radius",
      "ietf-system:radius-authentication",
      "ietf-ip:ipv6-privacy-autoconf"
    )
}

