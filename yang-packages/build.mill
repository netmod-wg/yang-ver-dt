  def reference = ""

  def includedPackages = Seq(ExampleAbPackage)
  def modules = 
    Seq("example-module-c@2.0.0")
  def excludedModules = 
    Seq("example-module-b")
  def excludedImportOnlyModules = 
    Seq("example-module-b-types")
  def optionalFeatures = 
    Seq("example-module-b:bar")
}



