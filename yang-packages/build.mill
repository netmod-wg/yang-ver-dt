object ExampleRoutingPkg extends ExamplePkgDefn {
  def name = "example-routing"
  def version = "1.3.1"
  override def timestamp = "2018-12-13T17:00:00Z"
  def description =
    descriptionText("""|This package defines a small sample set of IETF routing YANG modules
       |that could represent the set of IETF routing functionality that a basic
       |IP network device might be expected to support.""")
  def reference = "XXX, draft-ietf-netmod-yang-packages"
  def includedPackages = Seq(ExampleNetworkDevicePkg, ExampleRoutingTypesPkg)

  private def ietfModule(name: String, revision: String, hasLocation: Boolean = true) =
    yang.packages.tools.lib.Module(
      name,
      ModuleVersion(revision),
      Seq(s"https://www.iana.org/assignments/yang-parameters/$name@$revision.yang")
    )

  override def modules =
    Seq(
      ietfModule("ietf-routing", "2018-03-13"),
      ietfModule("ietf-ipv4-unicast-routing", "2018-03-13"),
      ietfModule("ietf-ipv6-unicast-routing", "2018-03-13"),
      ietfModule("ietf-isis", "2018-12-11", hasLocation = false),
      ietfModule("ietf-interfaces-common", "2018-07-02", hasLocation = false),
      ietfModule("ietf-if-l3-vlan", "2017-10-30", hasLocation = false),
      ietfModule("ietf-routing-policy", "2018-10-19", hasLocation = false),
      ietfModule("ietf-bgp", "2018-05-09", hasLocation = false),
      ietfModule("ietf-access-control-list", "2018-11-06", hasLocation = false),
    )

  override def importOnlyModules =
    Seq(
      ImportOnlyModule(
        "ietf-packet-fields",
        ModuleVersion("2018-11-06"),
        Seq("https://www.iana.org/assignments/yang-parameters/ietf-packet-fields@2018-11-06.yang")
      ),
      ImportOnlyModule(
        "ietf-ethertypes",
        ModuleVersion("2018-11-06"),
        Seq("https://www.iana.org/assignments/yang-parameters/ietf-ethertypes@2018-11-06.yang")
      ),
    )
  override def mandatoryFeatures =
    Seq(
      "ietf-access-control-list:match-on-ipv6",
      "ietf-access-control-list:ipv6"
    )
}

object DeviceRoutingPkg extends ExamplePkgDefn {
  def name = "device-routing"
  def version = "1.0.0"
  override def timestamp = "2026-06-22T00:00:00Z"
  def description =
    "Example vendor device routing package"
  def reference = "XXX, draft-ietf-netmod-yang-packages"

  def includedPackages = Seq(ExampleRoutingPkg)
  override def modules =
    Seq(
      yang.packages.tools.lib.Module(
        "vendor-ietf-bgp-deviations",
        ModuleVersion("2026-06-22"),
        Seq()
      ),
      yang.packages.tools.lib.Module(
        "device-isis-extensions",
        ModuleVersion("1.2.3"),
        Seq()
      )
    )
  def excludedModules =
    Seq("ietf-if-l3-vlan")
  override def optionalFeatures =
    Seq(
      "ietf-system:radius",
      "ietf-system:radius-authentication"
    )

  override def makePackage = Task:
    val pkg = YangPackage(
      name = PkgName(name),
      version = PkgVersion(version),
      versionDescription = versionDescription,
      timestamp = timestamp,
      organization = organization,
      contact = contact,
      description = description,
      reference = reference,
      complete = complete.getOrElse(true),
      includes = Includes(
        packages = Seq(
          YangPackageRef(
            PkgName(ExampleRoutingPkg.name),
            PkgVersion(ExampleRoutingPkg.version),
            Seq()
          )
        ),
        modules = modules.collect:
          case m: yang.packages.tools.lib.Module => m
          case moduleRev: String =>
            val (name, rev, locations) = moduleNameResolver(moduleRev)
            yang.packages.tools.lib.Module(name, rev, locations),
        importOnlyModules = importOnlyModules.collect:
          case m: ImportOnlyModule => m
          case moduleRev: String =>
            val (name, rev, locations) = moduleNameResolver(moduleRev)
            ImportOnlyModule(name, rev, locations),
        features = mandatoryFeatures
      ),
      excludes = Excludes(
        modules = excludedModules,
        importOnlyModules = excludedImportOnlyModules.collect:
          case m: ExcludedImportOnlyModules => m
          case moduleRev: String =>
            val (name, optVer) = moduleNameOptVerResolver(moduleRev)
            ExcludedImportOnlyModules(name, optVer),
        features = optionalFeatures
      ),
      mountedPackages = mountedPackages
    )
    val fileRef = Task.dest / Helper.packageFileName(pkg)
    pkg.writeToFile(fileRef)
    PathRef(fileRef)
}

