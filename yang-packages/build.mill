object DraftXml extends mill.Module:
  private case class YangModule(name: String, source: String)
  private case class PackageArtifact(pkg: PkgDefn, path: os.Path)

  private val modules = Seq(
    YangModule("ietf-yang-package-types", "ietf-yang-package-types.yang"),
    YangModule("ietf-yang-package-instance", "ietf-yang-package-instance.yang"),
    YangModule("ietf-yang-packages", "ietf-yang-packages.yang"),
    YangModule("ietf-yl-packages", "ietf-yl-packages.yang"),
    YangModule("ietf-yang-inst-data-pkg", "ietf-yang-inst-data-pkg.yang"),
  )

  private val examplePackages: Seq[PkgDefn] = Seq(
    YangInstDataSchemaPkg_0_1_0,
    ExampleBaseTypesPkg_1_0_0,
    ExampleBaseTypesPkg_1_1_0,
    ExampleDiagnosticsSchemaPkg,
    ExampleRoutingTypesPkg,
    ExampleAbPackage,
    ExampleCPackage,
    ExampleIetfNetworkDevicePkg,
    ExampleIetfRoutingPkg,
    ExampleImport1Pkg,
    ExampleImport2Pkg,
    Example3Pkg,
  )

  private def dir =
    Iterator.iterate(os.pwd)(_ / os.up).take(20)
      .find(p => os.exists(p / "draft-ietf-netmod-yang-packages.xml"))
      .getOrElse(sys.error("cannot find yang-packages directory"))

  private def depDirs =
    val repo = dir / os.up
    val fromEnv = sys.env.get("YANG_MODPATH").toSeq.flatMap(_.split(":"))
      .filter(_.nonEmpty).map(os.Path(_, os.pwd))
    (Seq(dir, repo / "yang-module-versioning", repo / "yang-semver",
      repo / "common-dependencies") ++ fromEnv).filter(os.exists)

  private def pyangEnv =
    val configured = sys.env.get("PYANG_ENV_SH").map(os.Path(_, os.pwd))
    configured.orElse(Some(os.Path("/Users/rwilton/git/pyang/env.sh")))
      .filter(os.exists)

  private def shellQuote(value: String) =
    "'" + value.replace("'", "'\"'\"'") + "'"

  private def sourcedCommand(cmd: Seq[String], cwd: os.Path) =
    pyangEnv match
      case Some(env) =>
        val envDir = env / os.up
        Seq(
          "sh",
          "-lc",
          Seq(
            "cd " + shellQuote(envDir.toString),
            ". " + shellQuote(env.toString),
            "cd " + shellQuote(cwd.toString),
            "exec " + cmd.map(shellQuote).mkString(" ")
          ).mkString(" && ")
        )
      case None => cmd

  private def run(cmd: Seq[String], cwd: os.Path = dir): String =
    val effectiveCmd = sourcedCommand(cmd, cwd)
    val process = new ProcessBuilder(effectiveCmd.asJava).directory(cwd.toIO).start()
    val out = new String(process.getInputStream.readAllBytes, StandardCharsets.UTF_8)
    val err = new String(process.getErrorStream.readAllBytes, StandardCharsets.UTF_8)
    val code = process.waitFor()
    if code != 0 || err.trim.nonEmpty then
      throw RuntimeException((effectiveCmd.mkString(" ") + "\n" + err + out).trim)
    out

  private def pyangBase =
    Seq("pyang", "-W", "error") ++
      depDirs.flatMap(p => Seq("-p", p.toString))

  private def versionOf(text: String) =
    """(?m)^\s+ys:version\s+([^;]+);""".r.findFirstMatchIn(text)
      .map(_.group(1)).getOrElse(sys.error("missing ys:version"))

  private def oneReplace(text: String, regex: String, replacement: Matcher => String) =
    val matcher = Pattern.compile(regex, Pattern.DOTALL).matcher(text)
    if !matcher.find() then sys.error(s"no XML block matched: $regex")
    val start = matcher.start()
    val end = matcher.end()
    val value = replacement(matcher)
    if matcher.find() then sys.error(s"more than one XML block matched: $regex")
    text.substring(0, start) + value + text.substring(end)

  private def packageTypesFigure(tree: String) =
    val lines = tree.linesIterator.toVector
    val start = lines.indexWhere(_.contains("grouping yang-pkg-instance:"))
    if start == -1 then sys.error("yang-pkg-instance grouping not found")
    val end = lines.indexWhere(_.startsWith("  grouping "), start + 1)
    val block = lines.slice(start, if end == -1 then lines.length else end)
    (lines.take(2) ++ block).mkString("\n")

  private def xmlTreeFigure(module: YangModule, tree: String) =
    module.name match
      case "ietf-yang-package-instance" =>
        """module: ietf-yang-package-instance
          |
          |  structure package:
          |    // Uses the yang-package-instance grouping defined in
          |    // ietf-yang-package-types.yang
          |    +-- name                  pkg-name
          |    +-- version               pkg-version
          |    ... remainder of yang-package-instance grouping ...""".stripMargin
      case "ietf-yang-packages" =>
        """module: ietf-yang-packages
          |  +--ro packages
          |     +--ro package* [name version]
          |        // Uses the yang-package-instance grouping defined in
          |        // ietf-yang-package-types.yang.
          |        +--ro name                  pkg-name
          |        +--ro version               pkg-version
          |        ... remainder of yang-package-instance grouping ...""".stripMargin
      case "ietf-yang-inst-data-pkg" =>
        """module: ietf-yang-inst-data-pkg
          |
          |  augment-structure /yid:instance-data-set/...
          |    +--:(pkg-schema)
          |       +-- pkg-schema
          |          +-- name        pkg-name
          |          +-- version     pkg-version
          |          +-- location*   inet:uri""".stripMargin
      case _ => tree.trim

  private def treeOptions(module: YangModule) =
    module.name match
      case "ietf-yang-package-types" => Seq("--tree-print-groupings")
      case "ietf-yang-package-instance" | "ietf-yang-inst-data-pkg" =>
        Seq("--tree-print-structures")
      case _ => Seq.empty

  private enum FoldingStyle:
    case SingleBackslash, DoubleBackslash

  private val singleBackslashHeader =
    "NOTE: '" + "\\" + "' line wrapping per RFC 8792"
  private val doubleBackslashHeader =
    "NOTE: '" + "\\\\" + "' line wrapping per RFC 8792"

  private def headerText(style: FoldingStyle) =
    style match
      case FoldingStyle.SingleBackslash => singleBackslashHeader
      case FoldingStyle.DoubleBackslash => doubleBackslashHeader

  private def foldingHeader(style: FoldingStyle, maxCol: Int) =
    val text = headerText(style)
    val length = text.length + 2
    val left = (maxCol - length) / 2
    val right = maxCol - length - left
    ("=" * left) + " " + text + " " + ("=" * right)

  private def foldSplitIndex(line: String, foldCol: Int, spaceWindow: Int = 20) =
    val limit = math.min(foldCol, line.length)
    val firstCandidate = math.max(0, limit - spaceWindow)
    (limit - 1 to firstCandidate by -1)
      .find(idx => line.charAt(idx) == ' ')
      .map(_ + 1)
      .orElse:
        val tokenStart = line.lastIndexWhere(_.isWhitespace, limit - 1) + 1
        (limit - 1 to tokenStart by -1)
          .find(idx => line.charAt(idx) == '/')
          .map(_ + 1)
      .getOrElse(limit)

  private def foldSingleBackslash(lines: Vector[String], maxCol: Int) =
    if lines.exists(_.endsWith("\\")) then None
    else
      val foldCol = maxCol - 1

      def foldLine(line: String): Option[Vector[String]] =
        if line.length <= maxCol then Some(Vector(line))
        else
          val (head, tail) = line.splitAt(foldSplitIndex(line, foldCol))
          foldLine(tail).map((head + "\\") +: _)

      lines.foldLeft(Option(Vector.empty[String])):
        case (Some(acc), line) => foldLine(line).map(acc ++ _)
        case (None, _) => None

  private def foldDoubleBackslash(lines: Vector[String], maxCol: Int) =
    if lines.sliding(2).exists:
        case Seq(a, b) => a.endsWith("\\") && b.dropWhile(_ == ' ').startsWith("\\")
        case _ => false
      then None
    else
      val foldCol = maxCol - 1
      def foldLine(line: String): Vector[String] =
        if line.length <= maxCol then Vector(line)
        else
          val (head, tail) = line.splitAt(foldSplitIndex(line, foldCol))
          (head + "\\") +: foldLine("\\" + tail)
      Some(lines.flatMap(foldLine))

  private def foldLongLines(text: String, maxCol: Int = 72) =
    val lines = text.linesIterator.toVector
    if lines.forall(_.length <= maxCol) then text
    else
      if lines.exists(_.contains('\t')) then
        sys.error("cannot fold example containing TAB characters")

      val folded =
        foldSingleBackslash(lines, maxCol)
          .map(FoldingStyle.SingleBackslash -> _)
          .orElse(foldDoubleBackslash(lines, maxCol)
            .map(FoldingStyle.DoubleBackslash -> _))
          .getOrElse(sys.error("cannot fold example using RFC 8792"))

      val (style, body) = folded
      (Vector(foldingHeader(style, maxCol), "") ++ body).mkString("\n") + "\n"

  private def unfoldLongLines(text: String) =
    val trailingNewline = text.endsWith("\n")
    val lines = text.linesIterator.toVector
    val style =
      lines.headOption.collect:
        case line if line.contains(singleBackslashHeader) =>
          FoldingStyle.SingleBackslash
        case line if line.contains(doubleBackslashHeader) =>
          FoldingStyle.DoubleBackslash

    def finish(unfolded: Vector[String]) =
      unfolded.mkString("\n") + (if trailingNewline then "\n" else "")

    style match
      case None => text
      case Some(FoldingStyle.SingleBackslash) =>
        finish(lines.drop(2).foldLeft(Vector.empty[String]):
          case (acc, line) if acc.lastOption.exists(_.endsWith("\\")) =>
            acc.init :+ (acc.last.dropRight(1) + line.dropWhile(_ == ' '))
          case (acc, line) => acc :+ line)
      case Some(FoldingStyle.DoubleBackslash) =>
        finish(lines.drop(2).foldLeft(Vector.empty[String]):
          case (acc, line)
              if acc.lastOption.exists(_.endsWith("\\"))
                && line.dropWhile(_ == ' ').startsWith("\\") =>
            val continuation = line.dropWhile(_ == ' ').drop(1)
            acc.init :+ (acc.last.dropRight(1) + continuation)
          case (acc, line) => acc :+ line)

  private def packageFileName(pkg: PkgDefn) =
    s"${pkg.name}@${pkg.version}.ypkg"

  private def packageExampleLocation(pkg: PkgDefn) =
    s"https://example.org/yang/packages/${packageFileName(pkg)}"

  private def packageCodeBlock(artifact: PackageArtifact) =
    s"""<CODE BEGINS> file "${packageFileName(artifact.pkg)}"
       |${foldLongLines(os.read(artifact.path).trim, maxCol = 69).trim}
       |<CODE ENDS>""".stripMargin

  private def sanitizePackageLocations(text: String, packageRefs: Seq[PathRef]) =
    examplePackages.zip(packageRefs).foldLeft(text):
      case (updated, (pkg, ref)) =>
        Seq(
          ref.path.toIO.toURI.toString,
          s"file:${ref.path}",
          s"file://${ref.path}",
        ).foldLeft(updated)((acc, local) => acc.replace(local, packageExampleLocation(pkg)))

  private def writeExamplePackages(packageRefs: Seq[PathRef]) =
    val outDir = dir / "generated" / "packages"
    os.makeDir.all(outDir)
    examplePackages.zip(packageRefs).map: (pkg, ref) =>
      val path = outDir / packageFileName(pkg)
      os.write.over(path, sanitizePackageLocations(os.read(ref.path), packageRefs))
      println(s"Package written to $path")
      PackageArtifact(pkg, path)

  private def writeTreeFiles(trees: Seq[PathRef]) =
    val outDir = dir / "generated" / "tree"
    os.makeDir.all(outDir)
    trees.map: ref =>
      val path = outDir / ref.path.last
      os.copy.over(ref.path, path)
      println(s"Tree diagram written to $path")
      PathRef(path)

  private def packageBlockLabels(pkg: PkgDefn) =
    val generated = packageFileName(pkg)
    val unversioned = s"${pkg.name}.ypkg"
    val legacy =
      pkg.name match
        case "yang-inst-data-schema-pkg" =>
          Seq(
            "ietf-yang-inst-data-schema@0.1.0.ypkg",
            "yang-inst-data-schema@0.1.0.ypkg",
          )
        case _ => Seq.empty
    (Seq(generated, unversioned) ++ legacy).distinct

  private def replacePackageCodeBlock(xml: String, artifact: PackageArtifact) =
    val labels = packageBlockLabels(artifact.pkg).map(Pattern.quote).mkString("|")
    oneReplace(
      xml,
      s"(<artwork><!\\[CDATA\\[\\s*)<CODE BEGINS> file \"(?:$labels)\"\\n" +
        ".*?<CODE ENDS>\\n[\\r\\n]*(\\h*)\\]\\]></artwork>",
      m => s"${m.group(1)}${packageCodeBlock(artifact)}\n${m.group(2)}]]></artwork>"
    )

  private def replaceResolutionExample(xml: String, artifacts: Seq[PackageArtifact]) =
    val byName = artifacts.map(a => a.pkg.name -> a).toMap
    val body =
      Seq("example-import-1-pkg", "example-import-2-pkg", "example-3-pkg")
        .map: name =>
          s"""        <figure>
             |          <artwork><![CDATA[
             |${packageCodeBlock(byName(name))}
             |        ]]></artwork>
             |        </figure>""".stripMargin
        .mkString("\n\n")
    oneReplace(
      xml,
      "(<section anchor=\"resolved_example\".*?)(\\s*<figure>\\s*<artwork><!\\[CDATA\\[\\s*)" +
        ".*?(\\n      </section>)",
      m => s"${m.group(1)}\n\n$body${m.group(3)}"
    )

  private def updateXmlFile(trees: Seq[PathRef], packages: Seq[PackageArtifact]) =
    val treeByModule = modules.zip(trees.map(t => os.read(t.path)))
    val xmlPath = dir / "draft-ietf-netmod-yang-packages.xml"
    val updatedTrees = treeByModule.foldLeft(os.read(xmlPath)):
      case (xml, (module, tree)) =>
        oneReplace(
          xml,
          s"(<artwork><!\\[CDATA\\[\\s*)module: ${Pattern.quote(module.name)}.*?\\n[\\r\\n]*(\\h*)\\]\\]></artwork>",
          m => s"${m.group(1)}${xmlTreeFigure(module, tree)}\n${m.group(2)}]]></artwork>"
        )
    val updatedSources = modules.foldLeft(updatedTrees):
      case (xml, m) =>
        val source = os.read(dir / m.source).trim
        val version = versionOf(source)
        oneReplace(
          xml,
          s"(<artwork><!\\[CDATA\\[\\s*)<CODE BEGINS> file " +
            s""""${Pattern.quote(m.name)}#[^"]+\\.yang""" +
            ".*?<CODE ENDS>\\n[\\r\\n]*(\\h*)\\]\\]></artwork>",
          mtch => s"${mtch.group(1)}<CODE BEGINS> file \"${m.name}#$version.yang\"\n" +
            source + s"\n<CODE ENDS>\n${mtch.group(2)}]]></artwork>"
        )
    val packageBlocks = Seq(
      "yang-inst-data-schema-pkg",
      "example-base-types-pkg",
      "example-diagnostics-schema",
      "example-ietf-network-device-pkg",
      "example-ietf-routing-pkg",
      "example-ab-pkg",
      "example-c-pkg",
    )
    val updatedPackages = packages
      .filter(p => packageBlocks.contains(p.pkg.name))
      .foldLeft(updatedSources)(replacePackageCodeBlock)
    val updatedResolution = replaceResolutionExample(updatedPackages, packages)
    os.write.over(xmlPath, updatedResolution)
    xmlPath

  def checkYang = Task:
    run(pyangBase ++ modules.map(m => (dir / m.source).toString))

  def generatedTreeFiles = Task:
    checkYang()
    val outDir = Task.dest / "tree"
    os.makeDir.all(outDir)
    modules.map: m =>
      val tree = run(pyangBase ++ Seq("-f", "tree", "--tree-line-length=69") ++
        treeOptions(m) ++ Seq((dir / m.source).toString))
      val body =
        if m.name == "ietf-yang-package-types" then packageTypesFigure(tree)
        else tree.trim
      val path = outDir / s"${m.name}.tree"
      os.write.over(path, body + "\n")
      PathRef(path)

  def treeFiles() = Task.Command:
    writeTreeFiles(generatedTreeFiles())

  def buildExamples() = Task.Command:
    val packageRefs = Task.traverse(examplePackages)(_.makePackage)()
    writeExamplePackages(packageRefs)
    ()

  def updateXml() = Task.Command:
    val packageRefs = Task.traverse(examplePackages)(_.makePackage)()
    val packages = writeExamplePackages(packageRefs)
    val trees = generatedTreeFiles()
    updateXmlFile(trees, packages)

  def all() = Task.Command:
    checkYang()
    val packageRefs = Task.traverse(examplePackages)(_.makePackage)()
    val packages = writeExamplePackages(packageRefs)
    val trees = generatedTreeFiles()
    writeTreeFiles(trees)
    updateXmlFile(trees, packages)
