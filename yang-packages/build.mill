      ietfModule("ietf-netconf-acm", "2018-02-14"),
      ietfModule("ietf-key-chain", "2017-06-15"),
      ietfModule("ietf-ip", "2018-02-22"),
    )

  override def importOnlyModules =
    Seq(
      ImportOnlyModule(
        "ietf-yang-types",
        ModuleVersion("2013-07-15"),
        Seq("https://tiny.cc/ietf-yang/ietf-yang-types@2013-07-15.yang")
      ),
      ImportOnlyModule(
        "ietf-inet-types",
        ModuleVersion("2013-07-15"),
