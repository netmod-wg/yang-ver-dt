      yang.packages.tools.lib.Module("example-resolution-telemetry", ModuleVersion("1.2.0"), Seq())
    )
  override def importOnlyModules =
    Seq(
      ImportOnlyModule("example-resolution-types", ModuleVersion("1.4.0"), Seq())
    )
  override def mandatoryFeatures =
    Seq(
      "example-resolution-base:basic",
      "example-resolution-telemetry:events"
    )
}

